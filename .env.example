# Copy to an untracked .env. Never commit real values.
# PostgreSQL is not published on a public interface in production.
DATABASE_URL=postgres://ufacapital:change-me@postgres:5432/ufacapital?sslmode=disable

HTTP_ADDR=:8088
ENVIRONMENT=dev
PUBLIC_ORIGIN=http://127.0.0.1:8088

# Production uses argon2id m=19456 t=2 p=1. Tests may lower this.
ARGON_MEMORY=19456
ARGON_TIME=2
ARGON_THREADS=1

# Game hour length for the scheduler. Tests call the tick directly.
TICK_EVERY=2s

# In-game test grants. Off unless explicitly enabled. Not a public default password.
TEST_ADMIN_ENABLED=false

# Optional one-time superadmin. Leave empty in git. The server prints the TOTP secret once if the user is created.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Asset storage outside the executable path.
ASSET_DIR=data/assets
SEED_ASSET_DIR=assets/catalog
